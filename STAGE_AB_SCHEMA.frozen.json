  "stage_a": {
    "purpose": "Choose trade intent and pot-relative allocation without authoring an option price, strike, expiry, contract identifier, or quantity.",
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intents"
      ],
      "properties": {
        "intents": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/stage_a_intent"
          }
        }
      }
    },
    "decline_exact_json": "{\"intents\":[]}",
    "decline_is_terminal": true
  },
  "stage_b": {
    "purpose": "Select exactly one runtime-priced candidate for one Stage A intent, or decline. The model never authors price or quantity.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_id",
        "intent",
        "candidates"
      ],
      "properties": {
        "intent_id": {
          "type": "string",
          "pattern": "^intent_[1-3]$"
        },
        "intent": {
          "$ref": "#/$defs/stage_a_intent"
        },
        "candidates": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/runtime_candidate"
          }
        }
      }
    },
    "output_schema": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_id"
          ],
          "properties": {
            "candidate_id": {
              "type": "string",
              "pattern": "^cand_[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decline"
          ],
          "properties": {
            "decline": {
              "const": true
            }
          }
        }
      ]
    },
    "selection_exact_example": "{\"candidate_id\":\"cand_<64 lowercase hex characters>\"}",
    "decline_exact_json": "{\"decline\":true}",
    "decline_is_terminal": true
  },
